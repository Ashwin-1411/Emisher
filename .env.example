# Copy to `.env` and fill in. `.env` is git-ignored; never commit real keys.
# Lists are comma-separated.

# --- general -------------------------------------------------------------------------------
APP_ENV=dev
LOG_LEVEL=INFO

# --- API surface ---------------------------------------------------------------------------
# Shared secrets the extension sends in the X-API-Token header. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
API_TOKENS=change-me
# Only for local experiments: skips token checks entirely.
AUTH_DISABLED=false
# Origins allowed by CORS, e.g. chrome-extension://<your-extension-id>
CORS_ALLOWED_ORIGINS=
MAX_UPLOAD_BYTES=26214400
RATE_LIMIT_PER_MINUTE=30
# How long a Report stays retrievable (IOC export) and the max number kept in memory.
REPORT_TTL_SECONDS=900
REPORT_STORE_MAX=200

# --- cache (enrichment results only; never email content) ----------------------------------
CACHE_BACKEND=sqlite            # sqlite | memory
CACHE_PATH=data/cache.sqlite3
CACHE_TTL_VT_SECONDS=86400
CACHE_TTL_URLSCAN_SECONDS=21600
CACHE_TTL_RDAP_SECONDS=604800

# --- VirusTotal (free tier: ~4 req/min, 500/day). Leave empty to skip VT. -------------------
VT_API_KEY=
VT_REQUESTS_PER_MINUTE=4
VT_DAILY_QUOTA=500
VT_MAX_LOOKUPS_PER_REPORT=4
VT_MAX_WAIT_SECONDS=20

# --- urlscan.io. Leave empty to skip urlscan. ----------------------------------------------
URLSCAN_API_KEY=
URLSCAN_VISIBILITY=unlisted     # public | unlisted | private
URLSCAN_MAX_SCANS_PER_REPORT=2
URLSCAN_MAX_WAIT_SECONDS=30

# --- RDAP domain age (no key needed) -------------------------------------------------------
RDAP_ENABLED=true
RDAP_BASE_URL=https://rdap.org
RDAP_MAX_LOOKUPS_PER_REPORT=8

# --- network analysis (only used when enrich=true) -----------------------------------------
LIVE_AUTH_CHECKS=true           # re-run SPF/DKIM/DMARC against live DNS
DNS_TIMEOUT_SECONDS=4
EXPAND_SHORTENERS=true
HOP_ASN_LOOKUP_ENABLED=false    # ASN/country of hop IPs via Team Cymru DNS
HTTP_TIMEOUT_SECONDS=8

# --- scoring -------------------------------------------------------------------------------
SCORING_RULES_PATH=             # empty = bundled app/scoring/rules.yaml
SCORE_SUSPICIOUS_THRESHOLD=     # empty = value from rules.yaml
SCORE_PHISHING_THRESHOLD=
